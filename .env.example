# Copy to .env and adjust. All model selection lives HERE — never in code.

# LLM backend (Ollama or any endpoint a future provider implements)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Models (must be pulled in Ollama; the app auto-pulls missing ones at startup).
# Pick CHAT_MODEL by your available RAM/VRAM (approximate download sizes):
#   qwen3:4b      ~2.6 GB   default — good balance for most laptops
#   qwen3:8b      ~5.2 GB   stronger answers
#   qwen3:30b     ~18  GB   best quality; needs a large machine
#   llama3.2:3b   ~2.0 GB   very light
#   phi4          ~9.1 GB   strong reasoning, no thinking mode
CHAT_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text

# TTS backend for Audio Overviews:
#   kokoro            — Kokoro-82M via kokoro-onnx (auto-downloads weights on first use)
#   say               — macOS built-in `say` command (zero-install fallback)
TTS_MODEL=kokoro
# Voice pair for the two podcast hosts (backend-specific voice names)
TTS_VOICE_A=af_heart
TTS_VOICE_B=am_michael

# Speech-to-text for video/audio source transcription (faster-whisper).
# Sizes: whisper-tiny | whisper-base | whisper-small | whisper-medium | whisper-large-v3
# Weights download once into models/whisper/ on first transcription.
STT_MODEL=whisper-base

# Upload limits (documents / media)
MAX_UPLOAD_MB=50
MEDIA_MAX_UPLOAD_MB=1024

# OCR (optional, scanned PDFs only). Runs only for PDF pages that have no text
# layer, and only when an engine is installed (brew install tesseract;
# uv pip install pytesseract pillow). Never applied to text PDFs.
OCR_ENABLED=auto              # auto | true | false
OCR_LANG=eng
OCR_MIN_CHARS_PER_PAGE=40     # below this average, a PDF is treated as scanned
OCR_DPI=200

# Local tools used by the 🧮 Tools research toggle: how many tool rounds a
# single answer may take before it must answer (1-5).
TOOL_MAX_ROUNDS=2

# Server
HOST=127.0.0.1
PORT=8501

# MLX chat backend (Apple silicon, optional). Start `mlx_lm.server` and its
# models appear in the picker automatically. Chat only — embeddings stay on
# Ollama so the existing vector index remains valid.
MLX_ENABLED=auto
MLX_BASE_URL=http://127.0.0.1:8080/v1
