# Copy to .env and adjust. All model selection lives HERE — never in code.

# LLM backend (Ollama or any endpoint a future provider implements)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Models (must be pulled in Ollama; the app auto-pulls missing ones at startup)
CHAT_MODEL=qwen3:30b
EMBED_MODEL=nomic-embed-text

# TTS backend for Audio Overviews:
#   kokoro            — Kokoro-82M via kokoro-onnx (auto-downloads weights on first use)
#   say               — macOS built-in `say` command (zero-install fallback)
TTS_MODEL=kokoro
# Voice pair for the two podcast hosts (backend-specific voice names)
TTS_VOICE_A=af_heart
TTS_VOICE_B=am_michael

# Server
HOST=127.0.0.1
PORT=8501
